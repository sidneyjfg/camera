# Serviço local do CasaView e API local do MediaMTX.
CASAVIEW_PORT=3001
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
# IPs de câmeras conhecidas para verificar ONVIF se WS-Discovery não as anunciar.
